FROM node:20-alpine AS builder

WORKDIR /app

COPY g8_landing_frontend/package.json ./
RUN npm install

COPY g8_landing_frontend/ ./

ARG VITE_API_BASE_URL
ARG VITE_USE_MOCK_DATA
ARG VITE_CRM_LEADS_ENDPOINT
ARG VITE_CABRO_ORDERS_ENDPOINT
ARG VITE_HOTEL_ENQUIRIES_ENDPOINT
ARG VITE_WAITER_ALERT_ENDPOINT
ARG VITE_CONTACT_PHONE
ARG VITE_CONTACT_EMAIL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_USE_MOCK_DATA=$VITE_USE_MOCK_DATA
ENV VITE_CRM_LEADS_ENDPOINT=$VITE_CRM_LEADS_ENDPOINT
ENV VITE_CABRO_ORDERS_ENDPOINT=$VITE_CABRO_ORDERS_ENDPOINT
ENV VITE_HOTEL_ENQUIRIES_ENDPOINT=$VITE_HOTEL_ENQUIRIES_ENDPOINT
ENV VITE_WAITER_ALERT_ENDPOINT=$VITE_WAITER_ALERT_ENDPOINT
ENV VITE_CONTACT_PHONE=$VITE_CONTACT_PHONE
ENV VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL

RUN npm run build

FROM nginx:stable-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY g8_landing_frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
