# Django production
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=g8-backend.getotech.co.ke
CORS_ALLOWED_ORIGINS=https://g8-yatch.getotech.co.ke
CSRF_TRUSTED_ORIGINS=https://g8-yatch.getotech.co.ke,https://g8-backend.getotech.co.ke
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_USE_X_FORWARDED_HOST=True

DATABASE_URL=postgres://g8_yacht:replace-db-password@app-postgres:5432/g8_yacht
DJANGO_DB_PASSWORD=replace-db-password

KEYCLOAK_SERVER_URL=https://identy.getotech.co.ke
KEYCLOAK_REALM=g8-yacht
KEYCLOAK_AUDIENCE=pos-terminal
KEYCLOAK_ADMIN_USERNAME=replace-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=replace-keycloak-password
KEYCLOAK_DB_PASSWORD=replace-keycloak-db-password

VITE_API_URL=https://g8-backend.getotech.co.ke
VITE_KEYCLOAK_URL=https://identy.getotech.co.ke
VITE_KEYCLOAK_REALM=g8-yacht
VITE_KEYCLOAK_CLIENT_ID=pos-terminal

